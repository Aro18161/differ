{
  "name": "differ",
  "version": "0.1.0",
  "private": true,
  "description": "Claude 변경사항 리뷰 맥 앱",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@parcel/watcher": "^2.6.0",
    "diff": "^9.0.0",
    "ignore": "^7.0.16",
    "shell-quote": "^1.12.0",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-typescript": "0.23.2",
    "web-tree-sitter": "^0.27.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-virtual": "^3.14.28",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/shell-quote": "^1.7.5",
    "@vitejs/plugin-react": "^6.3.0",
    "@xyflow/react": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "45.4.1",
    "electron-vite": "^6.0.0",
    "elkjs": "0.12.1",
    "lucide-react": "^1.79.0",
    "monaco-editor": "^0.58.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zustand": "^5.1.0"
  },
  "engines": {
    "node": "24"
  },
  "packageManager": "pnpm@12.23.0",
  "productName": "Differ"
}
